{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "tier": {
          "enum": [
            "indie",
            "studio",
            "blockbuster"
          ],
          "title": "Tier",
          "type": "string"
        },
        "currency": {
          "const": "USD",
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "total_budget_usd": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Total Budget Usd",
          "type": "integer"
        },
        "reserve_usd": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Reserve Usd",
          "type": "integer"
        },
        "talent_budget_usd": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Talent Budget Usd",
          "type": "integer"
        },
        "talent_spend_usd": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Talent Spend Usd",
          "type": "integer"
        },
        "talent_remaining_usd": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Talent Remaining Usd",
          "type": "integer"
        }
      },
      "required": [
        "tier",
        "total_budget_usd",
        "reserve_usd",
        "talent_budget_usd",
        "talent_spend_usd",
        "talent_remaining_usd"
      ],
      "title": "Budget",
      "type": "object"
    },
    "DraftStatus": {
      "enum": [
        "awaiting_pick",
        "recast_available",
        "recast_preview",
        "review_locked",
        "production_finalized",
        "simulation_running",
        "simulation_failed",
        "results_available",
        "abandoned"
      ],
      "title": "DraftStatus",
      "type": "string"
    },
    "DraftVersions": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "feature_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Feature Id",
          "type": "string"
        },
        "pricing_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Pricing Id",
          "type": "string"
        },
        "rules_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Rules Id",
          "type": "string"
        },
        "scoring_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Scoring Id",
          "type": "string"
        },
        "ranking_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Ranking Version",
          "type": "string"
        },
        "role_mapping_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Role Mapping Version",
          "type": "string"
        },
        "prng_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Prng Version",
          "type": "string"
        },
        "simulation_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Simulation Version",
          "type": "string"
        },
        "catalog_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Catalog Id",
          "type": "string"
        },
        "catalog_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Catalog Hash",
          "type": "string"
        },
        "graph_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Graph Id",
          "type": "string"
        },
        "graph_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Graph Hash",
          "type": "string"
        },
        "feature_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feature Hash",
          "type": "string"
        },
        "pricing_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pricing Hash",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "feature_id",
        "pricing_id",
        "rules_id",
        "scoring_id",
        "ranking_version",
        "role_mapping_version",
        "prng_version",
        "simulation_version",
        "catalog_id",
        "catalog_hash",
        "graph_id",
        "graph_hash",
        "feature_hash",
        "pricing_hash"
      ],
      "title": "DraftVersions",
      "type": "object"
    },
    "FrozenRoleProfile": {
      "additionalProperties": false,
      "properties": {
        "person_id": {
          "format": "uuid",
          "title": "Person Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        }
      },
      "required": [
        "person_id",
        "role",
        "attributes",
        "evidence"
      ],
      "title": "FrozenRoleProfile",
      "type": "object"
    },
    "LiveCandidate": {
      "additionalProperties": false,
      "properties": {
        "card": {
          "$ref": "#/$defs/LiveCard"
        },
        "selectable": {
          "title": "Selectable",
          "type": "boolean"
        },
        "blocked_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Blocked Reason"
        }
      },
      "required": [
        "card",
        "selectable",
        "blocked_reason"
      ],
      "title": "LiveCandidate",
      "type": "object"
    },
    "LiveCard": {
      "additionalProperties": false,
      "properties": {
        "person_id": {
          "format": "uuid",
          "title": "Person Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "hiring_fee_usd": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Hiring Fee Usd",
          "type": "integer"
        },
        "fee_is_fictional": {
          "const": true,
          "default": true,
          "title": "Fee Is Fictional",
          "type": "boolean"
        },
        "source": {
          "enum": [
            "tmdb",
            "fixture"
          ],
          "title": "Source",
          "type": "string"
        },
        "talent_strength": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Talent Strength"
        },
        "genre_fit": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Genre Fit"
        },
        "specialties": {
          "items": {
            "enum": [
              "action",
              "adventure",
              "comedy",
              "crime",
              "drama",
              "horror",
              "mystery",
              "romance",
              "science_fiction",
              "thriller"
            ],
            "type": "string"
          },
          "title": "Specialties",
          "type": "array"
        },
        "coverage": {
          "title": "Coverage",
          "type": "string"
        },
        "notable_works": {
          "items": {
            "$ref": "#/$defs/LiveWork"
          },
          "maxItems": 5,
          "title": "Notable Works",
          "type": "array"
        },
        "versions": {
          "$ref": "#/$defs/DraftVersions"
        }
      },
      "required": [
        "person_id",
        "name",
        "role",
        "hiring_fee_usd",
        "source",
        "talent_strength",
        "genre_fit",
        "specialties",
        "coverage",
        "notable_works",
        "versions"
      ],
      "title": "LiveCard",
      "type": "object"
    },
    "LiveDraft": {
      "additionalProperties": false,
      "properties": {
        "draft_id": {
          "format": "uuid",
          "title": "Draft Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DraftStatus"
        },
        "genre_id": {
          "enum": [
            "action",
            "adventure",
            "comedy",
            "crime",
            "drama",
            "horror",
            "mystery",
            "romance",
            "science_fiction",
            "thriller"
          ],
          "title": "Genre Id",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "picks": {
          "items": {
            "$ref": "#/$defs/PickView"
          },
          "maxItems": 8,
          "title": "Picks",
          "type": "array"
        },
        "current_offer": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiveOffer"
            },
            {
              "type": "null"
            }
          ]
        },
        "rerolls_used": {
          "maximum": 2,
          "minimum": 0,
          "title": "Rerolls Used",
          "type": "integer"
        },
        "recasts_used": {
          "maximum": 1,
          "minimum": 0,
          "title": "Recasts Used",
          "type": "integer"
        },
        "versions": {
          "$ref": "#/$defs/DraftVersions"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        },
        "minimum_remaining_cost_usd": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Minimum Remaining Cost Usd"
        },
        "can_reroll": {
          "title": "Can Reroll",
          "type": "boolean"
        },
        "reroll_unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reroll Unavailable Reason"
        },
        "snapshot_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Snapshot Hash"
        }
      },
      "required": [
        "draft_id",
        "status",
        "genre_id",
        "revision",
        "budget",
        "picks",
        "current_offer",
        "rerolls_used",
        "recasts_used",
        "versions",
        "synthetic",
        "minimum_remaining_cost_usd",
        "can_reroll",
        "reroll_unavailable_reason",
        "snapshot_hash"
      ],
      "title": "LiveDraft",
      "type": "object"
    },
    "LiveOffer": {
      "additionalProperties": false,
      "properties": {
        "offer_id": {
          "format": "uuid",
          "title": "Offer Id",
          "type": "string"
        },
        "slot": {
          "$ref": "#/$defs/Slot"
        },
        "kind": {
          "enum": [
            "pick",
            "recast"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/LiveCandidate"
          },
          "maxItems": 3,
          "title": "Candidates",
          "type": "array"
        },
        "shortage_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Shortage Message"
        },
        "generated_at_revision": {
          "minimum": 0,
          "title": "Generated At Revision",
          "type": "integer"
        }
      },
      "required": [
        "offer_id",
        "slot",
        "kind",
        "revision",
        "candidates",
        "shortage_message",
        "generated_at_revision"
      ],
      "title": "LiveOffer",
      "type": "object"
    },
    "LiveWork": {
      "additionalProperties": false,
      "properties": {
        "movie_id": {
          "format": "uuid",
          "title": "Movie Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1800,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Year"
        },
        "credited_jobs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Credited Jobs",
          "type": "array"
        },
        "poster_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Poster Path"
        },
        "audience_rating": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Audience Rating"
        },
        "vote_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Vote Count"
        },
        "source": {
          "enum": [
            "tmdb",
            "fixture"
          ],
          "title": "Source",
          "type": "string"
        },
        "poster_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Poster Url"
        }
      },
      "required": [
        "movie_id",
        "title",
        "year",
        "credited_jobs",
        "poster_path",
        "audience_rating",
        "vote_count",
        "source",
        "poster_url"
      ],
      "title": "LiveWork",
      "type": "object"
    },
    "PickView": {
      "additionalProperties": false,
      "properties": {
        "slot": {
          "$ref": "#/$defs/Slot"
        },
        "person_id": {
          "format": "uuid",
          "title": "Person Id",
          "type": "string"
        },
        "locked_fee_usd": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Locked Fee Usd",
          "type": "integer"
        },
        "offer_id": {
          "format": "uuid",
          "title": "Offer Id",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "person_id",
        "locked_fee_usd",
        "offer_id"
      ],
      "title": "PickView",
      "type": "object"
    },
    "Role": {
      "enum": [
        "director",
        "actor",
        "writer",
        "cinematographer",
        "composer"
      ],
      "title": "Role",
      "type": "string"
    },
    "Slot": {
      "enum": [
        "director",
        "lead",
        "co_lead",
        "supporting_1",
        "supporting_2",
        "writer",
        "cinematographer",
        "composer"
      ],
      "title": "Slot",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "phase7-v1",
      "default": "phase7-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    },
    "draft": {
      "$ref": "#/$defs/LiveDraft"
    },
    "seed": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Seed",
      "type": "string"
    },
    "cards": {
      "items": {
        "$ref": "#/$defs/LiveCard"
      },
      "maxItems": 8,
      "minItems": 8,
      "title": "Cards",
      "type": "array"
    },
    "rules_configuration": {
      "additionalProperties": true,
      "title": "Rules Configuration",
      "type": "object"
    },
    "scoring_configuration": {
      "additionalProperties": true,
      "title": "Scoring Configuration",
      "type": "object"
    },
    "rounding": {
      "const": "integer-usd-half-up",
      "default": "integer-usd-half-up",
      "title": "Rounding",
      "type": "string"
    },
    "role_features": {
      "items": {
        "$ref": "#/$defs/FrozenRoleProfile"
      },
      "maxItems": 8,
      "minItems": 8,
      "title": "Role Features",
      "type": "array"
    },
    "graph_configuration": {
      "additionalProperties": true,
      "title": "Graph Configuration",
      "type": "object"
    },
    "collaborations": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "maxItems": 12,
      "minItems": 12,
      "title": "Collaborations",
      "type": "array"
    }
  },
  "required": [
    "synthetic",
    "draft",
    "seed",
    "cards",
    "rules_configuration",
    "scoring_configuration",
    "role_features",
    "graph_configuration",
    "collaborations"
  ],
  "title": "FrozenDraft",
  "type": "object"
}
