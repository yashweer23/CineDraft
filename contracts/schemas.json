          "type": "string"
        },
        "currency": {
          "const": "USD",
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "total_budget_usd": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Total Budget Usd",
          "type": "integer"
        },
        "reserve_usd": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Reserve Usd",
          "type": "integer"
        },
        "talent_budget_usd": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Talent Budget Usd",
          "type": "integer"
        },
        "talent_spend_usd": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Talent Spend Usd",
          "type": "integer"
        },
        "talent_remaining_usd": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Talent Remaining Usd",
          "type": "integer"
        }
      },
      "required": [
        "tier",
        "total_budget_usd",
        "reserve_usd",
        "talent_budget_usd",
        "talent_spend_usd",
        "talent_remaining_usd"
      ],
      "title": "Budget",
      "type": "object"
    },
    "CandidateCard": {
      "additionalProperties": false,
      "properties": {
        "person_id": {
          "format": "uuid",
          "title": "Person Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "hiring_fee_usd": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Hiring Fee Usd",
          "type": "integer"
        },
        "fee_is_fictional": {
          "const": true,
          "default": true,
          "title": "Fee Is Fictional",
          "type": "boolean"
        },
        "source": {
          "enum": [
            "tmdb",
            "fixture"
          ],
          "title": "Source",
          "type": "string"
        },
        "talent_strength": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Talent Strength"
        },
        "genre_fit": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Genre Fit"
        },
        "specialties": {
          "items": {
            "enum": [
              "action",
              "adventure",
              "comedy",
              "crime",
              "drama",
              "horror",
              "mystery",
              "romance",
              "science_fiction",
              "thriller"
            ],
            "type": "string"
          },
          "title": "Specialties",
          "type": "array"
        },
        "coverage": {
          "title": "Coverage",
          "type": "string"
        },
        "notable_works": {
          "items": {
            "$ref": "#/$defs/NotableWork"
          },
          "maxItems": 5,
          "title": "Notable Works",
          "type": "array"
        },
        "versions": {
          "$ref": "#/$defs/VersionBundle"
        }
      },
      "required": [
        "person_id",
        "name",
        "role",
        "hiring_fee_usd",
        "source",
        "talent_strength",
        "genre_fit",
        "specialties",
        "coverage",
        "notable_works",
        "versions"
      ],
      "title": "CandidateCard",
      "type": "object"
    },
    "CatalogPage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/CandidateCard"
          },
          "title": "Items",
          "type": "array"
