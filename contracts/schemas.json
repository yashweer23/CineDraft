    "FrozenInputs": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "phase3-v1",
          "default": "phase3-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        },
        "draft": {
