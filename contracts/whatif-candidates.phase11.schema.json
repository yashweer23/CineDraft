{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "card": {
          "$ref": "#/$defs/LiveCard"
        },
        "is_original": {
          "title": "Is Original",
          "type": "boolean"
        },
        "selectable": {
          "title": "Selectable",
          "type": "boolean"
        },
        "blocked_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Blocked Reason"
        },
        "hypothetical_spend_usd": {
          "title": "Hypothetical Spend Usd",
          "type": "integer"
        }
      },
      "required": [
        "card",
        "is_original",
        "selectable",
        "blocked_reason",
        "hypothetical_spend_usd"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "DraftVersions": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "feature_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Feature Id",
          "type": "string"
        },
        "pricing_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Pricing Id",
          "type": "string"
        },
        "rules_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Rules Id",
          "type": "string"
        },
        "scoring_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Scoring Id",
          "type": "string"
        },
        "ranking_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Ranking Version",
          "type": "string"
        },
        "role_mapping_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Role Mapping Version",
          "type": "string"
        },
        "prng_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Prng Version",
          "type": "string"
        },
        "simulation_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Simulation Version",
          "type": "string"
        },
        "catalog_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Catalog Id",
          "type": "string"
        },
        "catalog_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Catalog Hash",
          "type": "string"
        },
        "graph_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Graph Id",
          "type": "string"
        },
        "graph_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Graph Hash",
          "type": "string"
        },
        "feature_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feature Hash",
          "type": "string"
        },
        "pricing_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pricing Hash",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "feature_id",
        "pricing_id",
        "rules_id",
        "scoring_id",
        "ranking_version",
        "role_mapping_version",
        "prng_version",
        "simulation_version",
        "catalog_id",
        "catalog_hash",
        "graph_id",
        "graph_hash",
        "feature_hash",
        "pricing_hash"
      ],
      "title": "DraftVersions",
      "type": "object"
    },
    "LiveCard": {
      "additionalProperties": false,
      "properties": {
        "person_id": {
          "format": "uuid",
          "title": "Person Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "hiring_fee_usd": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Hiring Fee Usd",
          "type": "integer"
        },
        "fee_is_fictional": {
          "const": true,
          "default": true,
          "title": "Fee Is Fictional",
          "type": "boolean"
        },
        "source": {
          "enum": [
            "tmdb",
            "fixture"
          ],
          "title": "Source",
          "type": "string"
        },
        "talent_strength": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Talent Strength"
        },
        "genre_fit": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Genre Fit"
        },
        "specialties": {
          "items": {
            "enum": [
              "action",
              "adventure",
              "comedy",
              "crime",
              "drama",
              "horror",
              "mystery",
              "romance",
              "science_fiction",
              "thriller"
            ],
            "type": "string"
          },
          "title": "Specialties",
          "type": "array"
        },
        "coverage": {
          "title": "Coverage",
          "type": "string"
        },
        "notable_works": {
          "items": {
            "$ref": "#/$defs/LiveWork"
          },
          "maxItems": 5,
          "title": "Notable Works",
          "type": "array"
        },
        "versions": {
          "$ref": "#/$defs/DraftVersions"
        }
      },
      "required": [
        "person_id",
        "name",
        "role",
        "hiring_fee_usd",
        "source",
        "talent_strength",
        "genre_fit",
        "specialties",
        "coverage",
        "notable_works",
        "versions"
      ],
      "title": "LiveCard",
      "type": "object"
    },
    "LiveWork": {
      "additionalProperties": false,
      "properties": {
        "movie_id": {
          "format": "uuid",
          "title": "Movie Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1800,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Year"
        },
        "credited_jobs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Credited Jobs",
          "type": "array"
        },
        "poster_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Poster Path"
        },
        "audience_rating": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Audience Rating"
        },
        "vote_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Vote Count"
        },
        "source": {
          "enum": [
            "tmdb",
            "fixture"
          ],
          "title": "Source",
          "type": "string"
        },
        "poster_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Poster Url"
        }
      },
      "required": [
        "movie_id",
        "title",
        "year",
        "credited_jobs",
        "poster_path",
        "audience_rating",
        "vote_count",
        "source",
        "poster_url"
      ],
      "title": "LiveWork",
      "type": "object"
    },
    "Role": {
      "enum": [
        "director",
        "actor",
        "writer",
        "cinematographer",
        "composer"
      ],
      "title": "Role",
      "type": "string"
    },
    "Slot": {
      "enum": [
        "director",
        "lead",
        "co_lead",
        "supporting_1",
        "supporting_2",
        "writer",
        "cinematographer",
        "composer"
      ],
      "title": "Slot",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "slot": {
      "$ref": "#/$defs/Slot"
    },
    "original": {
      "$ref": "#/$defs/LiveCard"
    },
    "available_after_refund_usd": {
      "title": "Available After Refund Usd",
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Items",
      "type": "array"
    },
    "next_offset": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Offset"
    }
  },
  "required": [
    "slot",
    "original",
    "available_after_refund_usd",
    "items",
    "next_offset"
  ],
  "title": "Candidates",
  "type": "object"
}
