# Prefer: node scripts/setup-env.cjs (generates a random local password).
# These values are for the local Docker database, not an external service.
POSTGRES_USER=cinedraft
POSTGRES_PASSWORD=replace_with_your_local_password
POSTGRES_DB=cinedraft
# Change to 5433 if the default host port is occupied. Container port stays 5432.
POSTGRES_PORT=5432

# Change if port 8000 is already occupied. Container port stays 8000.
API_PORT=8000

# Change to 5174 if the default host port is occupied. Container port stays 5173.
WEB_PORT=5173
